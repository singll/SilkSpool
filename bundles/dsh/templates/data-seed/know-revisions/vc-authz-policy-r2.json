    "hypothesis": "只有独立策略禁止低权访问、拥有者正对照成立且低权获得同一对象数据，才能形成越权判定。",
    "minimalProbe": "分别读取拥有者响应、低权响应与拥有者可见的访问策略；每例三次候选请求。",
    "executionPlan": {
      "kind": "authz-read-v2",
      "probes": ["owner", "low", "policy"],
      "requireOwner200": true,
      "deniedStatuses": [401, 403, 404],
      "compareFields": ["id", "owner", "data"]
    },
    "positiveControl": "拥有者得到预期对象，策略引用同一对象及低权主体。",
    "negativeControl": "仅当策略禁止低权访问时期待拒绝；公开资源及显式共享不适用此负对照。",
    "evidenceRequired": ["request_context", "identity_ref", "object_owner", "independent_access_policy", "behavior_assertion"],
    "stopConditions": ["scope_changed", "test_identity_invalid", "policy_unavailable", "gateway_failure"],
    "fixtures": {
      "vulnerable": "missing_ownership_check",
      "patched": ["enforced", "public_resource", "explicit_share"],
      "invalid_env": ["owner_token_invalid", "gateway_error", "missing_policy"]
    },
    "budget": { "maxRequests": 24, "maxSeconds": 30 },
    "failureNotes": "正对照或策略读取失败记环境异常；缺少策略探针记未知。不得从相同响应推定私有性，也不得将受控评测结果计作真实站点漏洞。",
