# generated by sec-browser-profiles.sh — do not edit
# 隔离共享浏览器 profile 路由片段；由 /opt/silkspool/dsh/edge-Caddyfile import。
# 至少含 primary；用 sec-browser-profiles.sh add <name> 增补其它 profile。
handle_path /p/primary/* {
    handle / {
        root * /opt/silkspool/dsh/edge-static
        rewrite / /browser.html
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:9222 {
            header_up Host 192.168.7.107:9223
        }
    }
}
