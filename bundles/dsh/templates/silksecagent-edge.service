[Unit]
Description=SilkSecAgent LAN edge (socat 192.168.7.107:3080 -> 127.0.0.1:3080; dsh rc.7 仅允许 loopback 绑定)
After=silksecagent.service
Requires=silksecagent.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:3080,bind=192.168.7.107,fork,reuseaddr TCP:127.0.0.1:3080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
