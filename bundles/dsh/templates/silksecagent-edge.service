[Unit]
Description=SilkSecAgent LAN edge (caddy :3080 -> 127.0.0.1:3081, shared browser :9223)
After=silksecagent.service
Requires=silksecagent.service

[Service]
Type=simple
ExecStart=/usr/bin/caddy run --config {{BASE_DIR}}/edge-Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
