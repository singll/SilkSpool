# SilkSecAgent 内网边缘反代（caddy 2.6.2）
# :3080 DSH Web UI（Host/Origin 改写绕 loopback 特权栅栏）；:9223 共享浏览器（basicauth + 落地页）
http://:3080 {
    reverse_proxy 127.0.0.1:3081 {
        header_up Host 127.0.0.1:3081
        header_up Origin "http://127.0.0.1:3081"
    }
}

# 共享浏览器 CDP/DevTools（basicauth 保护；profile=登录态凭据）
# 入口：http://browser.silksecagent.singll.net（经网关）或 http://192.168.7.107:9223
http://:9223 {
    basicauth {
        silksec $2b$14$ZeShsNfhSloJFL5ZqJ5RuOVCMxHS8cPv4wSKEYSHmCSCCJpc4DQD6
    }
    # 旧 DevTools 标签页依赖已撤下的外部前端；返回管理页获取当前 target 链接。
    # 浏览器重启后旧 target ID 也会失效，不把它继续转发给新实例。
    handle /serve_rev/* {
        header Cache-Control "no-store"
        redir * / 302
    }
    # 隔离 profile 路由（primary + 各隔离 profile，统一 /p/<name>/；由 sec-browser-profiles.sh 生成）
    import /opt/silkspool/dsh/edge-browser-profiles.caddy
    # profile 管理 API（同域统一界面的“新增 profile”后端；回环 9230）
    handle_path /_pool/* {
        reverse_proxy 127.0.0.1:9230 {
            header_up Host 192.168.7.107:9223
        }
    }
    # 统一管理页（/ → browser.html；/p/<name>/ → 该 profile 视图，同样由 browser.html 渲染）
    handle / {
        header Cache-Control "no-store"
        root * /opt/silkspool/dsh/edge-static
        rewrite / /browser.html
        file_server
    }
    # DevTools 前端由各 profile 自带的 /devtools/（Chromium 内置）经 /p/<name>/devtools/* 反代，
    # 不再依赖 chrome-devtools-frontend.appspot.com（该域在本网出口不可达）。
}
