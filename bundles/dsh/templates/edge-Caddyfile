# SilkSecAgent 内网边缘反代（caddy 2.6.2）
# :3080 DSH Web UI（Host/Origin 改写绕 loopback 特权栅栏）；:9223 共享浏览器（basicauth + 落地页）
http://:3080 {
    reverse_proxy 127.0.0.1:3081 {
        header_up Host 127.0.0.1:3081
        header_up Origin "http://127.0.0.1:3081"
    }
}

# 共享浏览器 CDP/DevTools（basicauth 保护；profile=登录态凭据）
# 入口：http://browser.silksecagent.singll.net（经网关）或 http://192.168.7.107:9223
http://:9223 {
    basicauth {
        silksec $2b$14$ZeShsNfhSloJFL5ZqJ5RuOVCMxHS8cPv4wSKEYSHmCSCCJpc4DQD6
    }
    handle / {
        root * /opt/silkspool/dsh/edge-static
        rewrite / /browser.html
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:9222 {
            header_up Host 192.168.7.107:9223
        }
    }
}
