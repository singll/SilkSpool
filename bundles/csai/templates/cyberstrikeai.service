[Unit]
Description=CyberStrikeAI - AI Native Security Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory={{BASE_DIR}}/CyberStrikeAI
EnvironmentFile=-{{BASE_DIR}}/.env
Environment=PATH={{BASE_DIR}}/CyberStrikeAI/venv/bin:/usr/local/go/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
ExecStart={{BASE_DIR}}/CyberStrikeAI/cyberstrike-ai --http
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
