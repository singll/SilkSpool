# ==============================================================================
#  Git 忽略规则配置
#  目的: 确保构建产物、敏感信息、临时文件不进入版本控制
# ==============================================================================

# --- 1. 证书与密钥 ---
*.pem
*.key
*.crt

# --- 2. 运行时与临时文件 ---
*.log
*.tmp
.DS_Store

# --- 3. IDE 配置 ---
.vscode/
.idea/
.claude/

# --- 4. Go 二进制文件 ---
/spool
spool-v2
*.exe

# --- 5. Build output (self-contained distribution) ---
out/

# --- 6. Python 缓存 ---
__pycache__/
*.pyc
*.pyo

# --- 7. SilkSpool 本地运行状态（lock/state/cache，不提交） ---
.spool/

# --- 8. 仓库根目录直接运行时的敏感运行时文件 ---
# 默认 out/ 布局已被忽略；以下规则保护在仓库根目录使用时的同名运行文件。
/hosts/
/keys/
/backups/
/known_hosts
/silkspool.yaml
