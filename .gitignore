# ==============================================================================
#  Git 忽略规则配置
#  目的: 确保构建产物、敏感信息、临时文件不进入版本控制
# ==============================================================================

# --- 1. 证书与密钥 ---
*.pem
*.key
*.crt

# --- 2. 运行时与临时文件 ---
*.log
*.tmp
.DS_Store

# --- 3. IDE 配置 ---
.vscode/
.idea/
.claude/

# --- 4. Go 二进制文件 ---
/spool
spool-v2
*.exe

# --- 5. Build output (self-contained distribution) ---
out/

# --- 6. Python 缓存 ---
__pycache__/
*.pyc
*.pyo
